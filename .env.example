# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=orbis

# Application Backend Database Connection URL
DATABASE_URL=postgresql://postgres:postgrespassword@database:5432/orbis?schema=public

# Backend Server Configuration
PORT=4000
BACKEND_REPLICAS=3

# Host ports exposed by the reverse proxy
HTTP_PORT=80
HTTPS_PORT=443

# Frontend configuration is embedded during `docker compose up --build`.
# Keep VITE_API_URL empty to use the same-origin Nginx `/api` proxy.
VITE_API_URL=
# Supply real Auth0 browser application values to enable Login/Register.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.orbis.com
VITE_AUTH0_SCOPE=openid profile email
VITE_AUTH0_REDIRECT_URI=https://localhost

# Auth0 Configuration (Placeholder for recruitment evaluation)
AUTH0_ISSUER_BASE_URL=https://dev-dummy.auth0.com/
AUTH0_AUDIENCE=https://api.orbis.com
