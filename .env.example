# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=orbis

# Application Backend Database Connection URL
DATABASE_URL=postgresql://postgres:postgrespassword@database:5432/orbis?schema=public

# Backend Server Configuration
PORT=4000

# Host ports exposed by the reverse proxy
HTTP_PORT=80
HTTPS_PORT=443

# Auth0 Configuration (Placeholder for recruitment evaluation)
AUTH0_ISSUER_BASE_URL=https://dev-dummy.auth0.com/
AUTH0_AUDIENCE=https://api.orbis.com
